# Template. Copy to nextcloud-secret.yaml (gitignored) and fill in real values:
#
#   cp Nextcloud/nextcloud-secret.example.yaml Nextcloud/nextcloud-secret.yaml
#   # generate values:
#   openssl rand -base64 24
#
# Or skip the file entirely and create the Secret imperatively:
#
#   kubectl -n nextcloud create secret generic nextcloud-secret \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=NEXTCLOUD_ADMIN_PASSWORD="$(openssl rand -base64 24)"
#
# NOTE: the previous passwords (nextcloud / admin) are in this repo's public
# git history. They must be considered compromised and rotated, not reused.
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-secret
  namespace: nextcloud
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_ME
  NEXTCLOUD_ADMIN_PASSWORD: REPLACE_ME
