# Template. Copy to wger-secret.yaml (gitignored) and fill in real values,
# or create the Secret directly:
#
#   kubectl -n wger create secret generic wger-secret \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=SECRET_KEY="$(openssl rand -base64 50)"
#
# POSTGRES_PASSWORD is shared by the database and the application workloads.
# SECRET_KEY is Django's signing key. Changing it invalidates active sessions.
apiVersion: v1
kind: Secret
metadata:
  name: wger-secret
  namespace: wger
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_ME
  SECRET_KEY: REPLACE_ME
