# Template. Copy to wger-secret.yaml (gitignored) and fill in real values.
#
#   kubectl -n wger create secret generic wger-secret \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=SECRET_KEY="$(openssl rand -base64 50)"
#
# POSTGRES_PASSWORD is used by the postgres, wger and celery deployments —
# all three must read the same value.
# SECRET_KEY is Django's signing key (sessions, CSRF tokens, password resets).
# Changing it logs everyone out; leaking it lets an attacker forge sessions.
#
# NOTE: the previous password (wger) is in this repo's public git history.
# Treat it as compromised and rotate it.
apiVersion: v1
kind: Secret
metadata:
  name: wger-secret
  namespace: wger
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_ME
  SECRET_KEY: REPLACE_ME
