# Template. Copy to splunk-secret.yaml (gitignored) and fill in a real value,
# or create the Secret directly:
#
#   kubectl -n splunk create secret generic splunk-secret \
#     --from-literal=SPLUNK_PASSWORD="$(openssl rand -base64 18)"
#
# Minimum 8 characters.
apiVersion: v1
kind: Secret
metadata:
  name: splunk-secret
  namespace: splunk
type: Opaque
stringData:
  SPLUNK_PASSWORD: REPLACE_ME
