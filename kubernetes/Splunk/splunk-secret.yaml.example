# Template. Copy to splunk-secret.yaml (gitignored) and fill in a real value.
#
#   kubectl -n splunk create secret generic splunk-secret \
#     --from-literal=SPLUNK_PASSWORD="$(openssl rand -base64 24)"
#
# Splunk requires >= 8 characters. This is the 'admin' account for the web UI
# on :8000 and the management API on :8089.
apiVersion: v1
kind: Secret
metadata:
  name: splunk-secret
  namespace: splunk
type: Opaque
stringData:
  SPLUNK_PASSWORD: REPLACE_ME
